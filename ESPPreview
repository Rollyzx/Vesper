    -- =========================================================================
    -- CORNER BOX — dibuja 8 segmentos de esquina
    -- =========================================================================
    local function DrawCornerBox(bx, by, bw, bh, color, thickness)
        local cW = math.floor(bw * 0.22)
        local cH = math.floor(bh * 0.22)
        local t  = thickness or 1
        local x2 = bx + bw
        local y2 = by + bh
        -- Cada segmento: from → to
        local segs = {
            {Vector2.new(bx,      by),      Vector2.new(bx + cW, by)     },  -- TL horiz
            {Vector2.new(bx,      by),      Vector2.new(bx,      by + cH)},  -- TL vert
            {Vector2.new(x2 - cW, by),      Vector2.new(x2,      by)     },  -- TR horiz
            {Vector2.new(x2,      by),      Vector2.new(x2,      by + cH)},  -- TR vert
            {Vector2.new(bx,      y2),      Vector2.new(bx + cW, y2)     },  -- BL horiz
            {Vector2.new(bx,      y2 - cH), Vector2.new(bx,      y2)     },  -- BL vert
            {Vector2.new(x2 - cW, y2),      Vector2.new(x2,      y2)     },  -- BR horiz
            {Vector2.new(x2,      y2 - cH), Vector2.new(x2,      y2)     },  -- BR vert
        }
        for i, seg in ipairs(segs) do
            cornerSegs[i].Size = UDim2.new(0, 1, 0, t)  -- reset
            DrawLine(cornerSegs[i], seg[1], seg[2], color, t)
        end
    end

    local function HideCorners()
        for _, f in ipairs(cornerSegs) do f.Visible = false end
    end

    -- =========================================================================
    -- GESTIÓN DEL CLON
    -- =========================================================================
    local clonedChar    = nil
    local currentTarget = nil

    local function DestroyClone()
        if clonedChar then pcall(function() clonedChar:Destroy() end) clonedChar = nil end
    end

    local function CloneCharacter(char)
        DestroyClone()
        local clone = char:Clone()
        for _, v in ipairs(clone:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Sound") or v:IsA("Animator") then
                v:Destroy()
            end
        end
        for _, v in ipairs(clone:GetDescendants()) do
            if v:IsA("BasePart") then v.Anchored = true; v.CanCollide = false end
        end
        clone.Parent = viewport
        clonedChar   = clone
        return clone
    end

    local function SyncClone(original, clone)
        for _, origPart in ipairs(original:GetDescendants()) do
            if origPart:IsA("BasePart") then
                local clonePart = clone:FindFirstChild(origPart.Name, true)
                if clonePart and clonePart:IsA("BasePart") then
                    clonePart.CFrame = origPart.CFrame
                end
            end
        end
    end

    local function UpdateCamera(char)
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if not root then return end
        local pos = root.Position
        vpCam.CFrame = CFrame.new(pos + Vector3.new(0, 1.1, 4.8), pos + Vector3.new(0, 0.7, 0))
    end


    -- =========================================================================
    -- RAINBOW STATE
    -- =========================================================================
    local rainbowHue = 0

    -- =========================================================================
    -- RENDER LOOP
    -- =========================================================================
    local frameCount = 0

    RunService.RenderStepped:Connect(function(dt)
        if not _G.ESPPreview.Enabled then
            if panel.Visible then panel.Visible = false; DestroyClone(); currentTarget = nil end
            return
        end
        panel.Visible = true
        frameCount    = frameCount + 1

        -- Buscar objetivo cada ~45 frames
        if frameCount % 45 == 0 or currentTarget == nil then
            local newTarget = GetNearestEnemy()
            if newTarget ~= currentTarget then
                currentTarget = newTarget
                if currentTarget and currentTarget.Character then
                    CloneCharacter(currentTarget.Character)
                else
                    DestroyClone()
                end
            end
        end

        if not (currentTarget and currentTarget.Character and clonedChar and clonedChar.Parent) then
            HideAll()
            infoText.Text = "~ sin objetivo ~"
            return
        end

        local char      = currentTarget.Character
        local humanoid  = char:FindFirstChildOfClass("Humanoid")
        local healthPct = humanoid and math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1) or 1

        local localChar = localPlayer.Character
        local localRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso"))
        local charRoot  = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        local dist      = (localRoot and charRoot) and math.floor((charRoot.Position - localRoot.Position).Magnitude) or 0

        local tool       = char:FindFirstChildOfClass("Tool")
        local weaponName = tool and tool.Name or ""

        SyncClone(char, clonedChar)
        UpdateCamera(clonedChar)
        noTargetLabel.Visible = false

        infoText.Text = currentTarget.Name
            .. "  •  " .. dist .. "m"
            .. (weaponName ~= "" and ("  •  " .. weaponName) or "")

        local espS = _G.ESPSettings

        -- ── Rainbow: calcular color global ──────────────────────────────────
        local isRainbow = espS and espS.RainbowMode
        if isRainbow then
            rainbowHue = (rainbowHue + dt * (espS.RainbowSpeed or 0.5)) % 1
        end
        local function rainbowOr(base)
            return isRainbow and Color3.fromHSV(rainbowHue, 1, 1) or (base or Color3.fromRGB(255,255,255))
        end

        -- ── Calcular posición y tamaño del box en 2D ──────────────────────
        local bx, by, bw, bh = nil, nil, nil, nil
        local head  = clonedChar:FindFirstChild("Head")
        local root2 = clonedChar:FindFirstChild("HumanoidRootPart") or clonedChar:FindFirstChild("Torso")
        if head and root2 then
            local hp = PartTo2D(head)
            local rp = PartTo2D(root2)
            if hp and rp then
                local vpW = viewport.AbsoluteSize.X
                bh = math.abs(rp.Y - hp.Y) + 22
                bw = bh * 0.58
                bx = vpW * 0.5 - bw * 0.5
                by = hp.Y - 11
            end
        end

        -- ── GLOW ────────────────────────────────────────────────────────────
        local glowOn = espS and espS.GlowEnabled
        chipGlow.Visible = glowOn and true or false
        if glowOn and bx then
            local pad = 10
            local gc  = rainbowOr(espS.GlowColor)
            glowFrame.BackgroundColor3       = gc
            glowFrame.BackgroundTransparency = espS.GlowTransparency or 0.5
            glowFrame.Size     = UDim2.new(0, math.floor(bw + pad*2), 0, math.floor(bh + pad*2))
            glowFrame.Position = UDim2.new(0, math.floor(bx - pad), 0, math.floor(by - pad))
            glowFrame.Visible  = true
            -- actualizar gradiente con color
            glowGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, gc),
                ColorSequenceKeypoint.new(1, gc),
            })
        else
            glowFrame.Visible = false
        end

        -- ── BOX FILL ────────────────────────────────────────────────────────
        local fillOn = espS and espS.BoxFillEnabled
        if fillOn and bx then
            boxFillFrame.BackgroundColor3       = rainbowOr(espS.BoxFillColor)
            boxFillFrame.BackgroundTransparency = espS.BoxFillTransparency or 0.7
            boxFillFrame.Size     = UDim2.new(0, math.floor(bw), 0, math.floor(bh))
            boxFillFrame.Position = UDim2.new(0, math.floor(bx), 0, math.floor(by))
            boxFillFrame.Visible  = true
        else
            boxFillFrame.Visible = false
        end

        -- ── BOX (Normal o Corner) ────────────────────────────────────────────
        local boxOn     = espS and espS.BoxEnabled
        local boxColor  = rainbowOr(espS and espS.BoxColor)
        local boxThick  = espS and math.clamp(espS.BoxThickness or 1, 1, 4) or 1
        local isCorner  = espS and (espS.BoxType == "Corner")

        if boxOn and bx then
            if isCorner then
                boxFrame.Visible = false
                DrawCornerBox(bx, by, bw, bh, boxColor, boxThick)
            else
                HideCorners()
                boxFrame.Size     = UDim2.new(0, math.floor(bw), 0, math.floor(bh))
                boxFrame.Position = UDim2.new(0, math.floor(bx), 0, math.floor(by))
                boxStroke.Color     = boxColor
                boxStroke.Thickness = boxThick
                boxFrame.Visible    = true
            end
        else
            boxFrame.Visible = false
            HideCorners()
        end

        -- ── TRACER ──────────────────────────────────────────────────────────
        local tracerOn  = espS and espS.TracersEnabled
        chipTracer.Visible = tracerOn and true or false
        if tracerOn and bx then
            local origin    = espS.TracersOrigin or "Bottom"
            local vpH       = viewport.AbsoluteSize.Y
            local vpW2      = viewport.AbsoluteSize.X
            -- punto de origen del tracer (desde donde sale la línea)
            local fromX, fromY
            if origin == "Center" then
                fromX = vpW2 * 0.5
                fromY = vpH * 0.5
            elseif origin == "Top" then
                fromX = vpW2 * 0.5
                fromY = 0
            else -- Bottom (default)
                fromX = vpW2 * 0.5
                fromY = vpH
            end
            -- destino: centro inferior del box
            local toX = bx + bw * 0.5
            local toY = by + bh
            local tc  = rainbowOr(espS.TracersColor)
            DrawLine(tracerFrame, Vector2.new(fromX, fromY), Vector2.new(toX, toY),
                     tc, espS.TracersThickness or 1)
            tracerFrame.Visible = true
        else
            tracerFrame.Visible = false
        end

        -- ── HEALTH BAR ──────────────────────────────────────────────────────
        if espS and espS.HealthBarEnabled then
            hbBg.Visible              = true
            hbFill.Size               = UDim2.new(1, -2, healthPct, 0)
            hbFill.Position           = UDim2.new(0, 1, 1 - healthPct, 0)
            hbFill.BackgroundColor3   = GetHPColor(healthPct)
        else
            hbBg.Visible = false
        end

        -- ── NOMBRE ──────────────────────────────────────────────────────────
        if espS and espS.NameEnabled then
            nameLabel.Text       = currentTarget.Name
            nameLabel.TextColor3 = rainbowOr(espS.NameColor)
            nameLabel.TextStrokeTransparency = (espS.NameOutline and 0 or 1)
            nameLabel.Visible    = true
        else
            nameLabel.Visible = false
        end

        -- ── DISTANCIA ───────────────────────────────────────────────────────
        if espS and espS.DistanceEnabled then
            distLabel.Text       = dist .. " m"
            distLabel.TextColor3 = espS.DistanceColor or Color3.fromRGB(200, 200, 200)
            distLabel.TextStrokeTransparency = (espS.DistanceOutline and 0 or 1)
            distLabel.Visible    = true
        else
            distLabel.Visible = false
        end

        -- ── ARMA ────────────────────────────────────────────────────────────
        weaponLabel.Text    = weaponName
        weaponLabel.Visible = weaponName ~= ""

        -- ── SKELETON ────────────────────────────────────────────────────────
        if espS and espS.SkeletonEnabled then
            local parts      = GetParts(clonedChar)
            local skelColor  = rainbowOr(espS.SkeletonColor)
            local skelThick  = espS.SkeletonThickness or 1
            local outColor   = espS.SkeletonOutlineColor or Color3.fromRGB(0,0,0)

            local bones = {}
            if parts.UpperTorso then
                bones = {
                    {parts.Head,          parts.UpperTorso},
                    {parts.UpperTorso,    parts.LowerTorso},
                    {parts.UpperTorso,    parts.RightUpperArm},
                    {parts.RightUpperArm, parts.RightLowerArm},
                    {parts.RightLowerArm, parts.RightHand},
                    {parts.UpperTorso,    parts.LeftUpperArm},
                    {parts.LeftUpperArm,  parts.LeftLowerArm},
                    {parts.LeftLowerArm,  parts.LeftHand},
                    {parts.LowerTorso,    parts.RightUpperLeg},
                    {parts.RightUpperLeg, parts.RightLowerLeg},
                    {parts.RightLowerLeg, parts.RightFoot},
                    {parts.LowerTorso,    parts.LeftUpperLeg},
                    {parts.LeftUpperLeg,  parts.LeftLowerLeg},
                    {parts.LeftLowerLeg,  parts.LeftFoot},
                }
            elseif parts.Torso then
                bones = {
                    {parts.Head,    parts.Torso},
                    {parts.Torso,   parts.RightArm},
                    {parts.Torso,   parts.LeftArm},
                    {parts.Torso,   parts.RightLeg},
                    {parts.Torso,   parts.LeftLeg},
                }
            end

            for i, bone in ipairs(bones) do
                if i > MAX_BONES then break end
                local s1 = bone[1] and PartTo2D(bone[1])
                local s2 = bone[2] and PartTo2D(bone[2])
                if s1 and s2 then
                    local stroke = skelLines[i]:FindFirstChildOfClass("UIStroke")
                    if stroke then stroke.Color = outColor; stroke.Thickness = skelThick + 1 end
                    DrawLine(skelLines[i], s1, s2, skelColor, math.max(1, skelThick))
                else
                    skelLines[i].Visible = false
                end
            end
            for i = #bones + 1, MAX_BONES do skelLines[i].Visible = false end
        else
            for _, l in ipairs(skelLines) do l.Visible = false end
        end

        -- ── CHIPS ───────────────────────────────────────────────────────────
        chipRainbow.Visible = isRainbow and true or false
        chipVisible.Visible = espS and espS.VisibleCheck and true or false
        chipTeam.Visible    = espS and espS.TeamCheck    and true or false
    end)

    -- =========================================================================
    -- LIVE BLINK
    -- =========================================================================
    task.spawn(function()
        while true do
            task.wait(0.8)
            if panel.Visible then
                TweenService:Create(liveLabel, TweenInfo.new(0.2), {BackgroundTransparency = 0.6}):Play()
                task.wait(0.25)
                TweenService:Create(liveLabel, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
            end
        end
    end)

    -- =========================================================================
    -- API PÚBLICA
    -- =========================================================================
    function _G.ESPPreview:Enable()  self.Enabled = true;  panel.Visible = true  end
    function _G.ESPPreview:Disable() self.Enabled = false; panel.Visible = false; DestroyClone(); currentTarget = nil end

    print("=== ESP PREVIEW PANEL LISTO ===")
end

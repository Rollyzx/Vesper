-- === CLONE MANAGEMENT ===
local clonedChar = nil
local currentTarget = nil
local currentTargetDist = 0
local isDummy = false
local cloneAttempts = 0
local maxCloneAttempts = 3
local lastCloneAttemptTime = 0

local function CloneCharacter(char)
    if not char or not char.Parent then
        DestroyClone()
        return
    end
    
    -- Evitar bucles infinitos de clonación
    if cloneAttempts >= maxCloneAttempts then
        local timeElapsed = tick() - lastCloneAttemptTime
        if timeElapsed < 0.5 then
            return
        end
        cloneAttempts = 0
    end
    
    cloneAttempts = cloneAttempts + 1
    lastCloneAttemptTime = tick()
    
    pcall(function()
        DestroyClone()
        
        -- Verificar que el personaje aún exista antes de clonarlo
        if not char or not char.Parent then
            return
        end
        
        local clone = char:Clone()
        if not clone then
            return
        end
        
        -- Destruir scripts y componentes innecesarios
        for _, v in ipairs(clone:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") or 
               v:IsA("Sound") or v:IsA("Animator") then
                v:Destroy()
            end
        end
        
        -- Configurar partes del clon
        for _, v in ipairs(clone:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Anchored = true
                v.CanCollide = false
            end
        end
        
        clone.Parent = worldModel
        clonedChar = clone
    end)
end

    local function SyncClone(original, clone)
        if not (original and clone) then return end
        pcall(function()
            for _, origPart in ipairs(original:GetDescendants()) do
                if origPart:IsA("BasePart") then
                    local clonePart = clone:FindFirstChild(origPart.Name, true)
                    if clonePart and clonePart:IsA("BasePart") then
                        clonePart.CFrame = origPart.CFrame
                    end
                end
            end
        end)
    end

    local function UpdateCamera(char)
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if not root then return end
        local pos = root.Position
        local lookAt = pos + Vector3.new(0,0.7,0)
        vpCam.CFrame = CFrame.new(pos + Vector3.new(0,1.2,4.8), lookAt)
    end

    -- === UTILITIES ===
    local function PartTo2D(part)
        if not part or not part.Parent then return nil end
        local s, visible = vpCam:WorldToViewportPoint(part.Position)
        if not visible or s.Z <= 0 then return nil end
        return Vector2.new(s.X, s.Y)
    end

    local function GetHPColor(pct)
        local low = S.HealthBarColorLow or Color3.fromRGB(255,50,50)
        local high = S.HealthBarColorHigh or Color3.fromRGB(0,255,100)
        return low:Lerp(high, pct)
    end

    -- === GetNearestEnemy (con dummy) ===
    local function GetNearestEnemy()
        local localChar = localPlayer.Character
        local localRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso"))
        if not localRoot then return nil, math.huge end

        local nearest, nearestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                local char = p.Character
                if char and char.Parent then
                    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                    if root and root.Parent then
                        local dist = (root.Position - localRoot.Position).Magnitude
                        if dist < nearestDist then
                            nearest, nearestDist = p, dist
                        end
                    end
                end
            end
        end

        if not nearest then
            if localChar and localChar.Parent then
                isDummy = true
                return localPlayer, 0
            else
                isDummy = false
                return nil, math.huge
            end
        else
            isDummy = false
            return nearest, nearestDist
        end
    end


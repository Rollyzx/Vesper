    -- =========================================================================
    local frameCount = 0
    local targetUpdateTimer = 0
    local targetUpdateInterval = 0.5

    RunService.RenderStepped:Connect(function(dt)
        if not _G.ESPPreview or not _G.ESPPreview.Enabled then
            panel.Visible = false
            DestroyClone()
            return
        end
        panel.Visible = true
        frameCount = frameCount + 1
        targetUpdateTimer = targetUpdateTimer + dt

        if targetUpdateTimer >= targetUpdateInterval or currentTarget == nil then
            targetUpdateTimer = 0
            local newTarget, dist = GetNearestEnemy()
            if newTarget ~= currentTarget then
                currentTarget = newTarget
                currentTargetDist = dist or math.huge
                if currentTarget and currentTarget.Character then
                    CloneCharacter(currentTarget.Character)
                else
                    DestroyClone()
                end
            else
                currentTargetDist = dist or currentTargetDist
            end
        end

        if not (currentTarget and currentTarget.Character and clonedChar and clonedChar.Parent) then
            HideAll()
            return
        end

        local char = currentTarget.Character
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local healthPct = humanoid and math.clamp(humanoid.Health / math.max(humanoid.MaxHealth,1), 0, 1) or 1
        local localRoot = localPlayer.Character and (localPlayer.Character:FindFirstChild("HumanoidRootPart") or localPlayer.Character:FindFirstChild("Torso"))
        local charRoot = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        local dist = (localRoot and charRoot) and math.floor((charRoot.Position - localRoot.Position).Magnitude) or 0

        -- Visibilidad en cámara
        local isVisible = false
        if charRoot then
            local _, onScreen = vpCam:WorldToViewportPoint(charRoot.Position)
            isVisible = onScreen
        end
        isTargetVisible = isVisible

        SyncClone(char, clonedChar)
        UpdateCamera(clonedChar)

        -- ====== GLOW ======
        if S.GlowEnabled then
            glowHL.Enabled = true
            glowHL.FillColor = S.GlowColor
            glowHL.OutlineColor = S.GlowColor
            glowHL.Adornee = clonedChar
        else
            glowHL.Enabled = false
        end

        -- ====== SHADOW ======
        if S.ShadowEnabled and charRoot then
            shadowPart.Transparency = 1 - (S.ShadowOpacity or 0.3)
            shadowPart.CFrame = CFrame.new(charRoot.Position + Vector3.new(0, -1.5, 0))
            local size = 1.2 + (dist / 200)
            shadowPart.Size = Vector3.new(size, 0.1, size)
        else
            shadowPart.Transparency = 1
        end

        -- ====== TRACER ======
        if S.TracerEnabled and localRoot and charRoot then
            local startPos = localRoot.Position
            local endPos = charRoot.Position
            local mid = (startPos + endPos) / 2
            local dir = (endPos - startPos)
            local length = dir.Magnitude
            if length > 0.5 then
                tracerPart.Transparency = 0.4 + (dist / 1000) * 0.3
                tracerPart.CFrame = CFrame.lookAt(mid, endPos) * CFrame.Angles(math.pi/2,0,0)
                tracerPart.Size = Vector3.new(0.08, length, 0.08)
                tracerPart.Color = S.TracerColor
            else
                tracerPart.Transparency = 1
            end
        else
            tracerPart.Transparency = 1
        end

        -- ====== BOX STYLE ======
        local boxStyle = S.BoxStyle or "2D"
        local headPart = clonedChar:FindFirstChild("Head")
        local rootPart = clonedChar:FindFirstChild("HumanoidRootPart") or clonedChar:FindFirstChild("Torso")

        if S.BoxEnabled and boxStyle ~= "None" and rootPart then
            local headPos2D, rootPos2D
            if headPart then headPos2D = PartTo2D(headPart) end
            rootPos2D = PartTo2D(rootPart)
            local vpW = viewport.AbsoluteSize.X
            local vpH = viewport.AbsoluteSize.Y

            if boxStyle == "2D" then
                if headPos2D and rootPos2D then
                    local bh = math.abs(rootPos2D.Y - headPos2D.Y) + 22
                    local bw = bh * 0.6
                    local bx = vpW * 0.5 - bw * 0.5
                    local by = headPos2D.Y - 12
                    boxFrame.Size = UDim2.new(0, math.floor(bw), 0, math.floor(bh))
                    boxFrame.Position = UDim2.new(0, math.floor(bx), 0, math.floor(by))
                    boxStroke.Color = S.BoxColor
                    boxStroke.Thickness = S.BoxThickness or 2
                    boxFrame.Visible = true
                else
                    boxFrame.Visible = false
                end
                box3D.Transparency = 1
            elseif boxStyle == "3D" then
                box3D.Transparency = 0.5 + (dist / 1000) * 0.3
                local headPos = headPart and headPart.Position or rootPart.Position + Vector3.new(0,2,0)
                local height = (headPos - rootPart.Position).Y + 0.5
                local width = height * 0.6
                box3D.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, height/2, 0))
                box3D.Size = Vector3.new(width, height, width)
                box3D.Color = S.BoxColor
                boxFrame.Visible = false
            elseif boxStyle == "Arrow" then
                if rootPos2D then
                    local center = Vector2.new(vpW/2, vpH/2)
                    local dir = (rootPos2D - center)
                    local angle = math.atan2(dir.Y, dir.X)
                    local arrowFrame = boxFrame
                    arrowFrame.Size = UDim2.new(0,20,0,20)
                    arrowFrame.Position = UDim2.new(0, rootPos2D.X - 10, 0, rootPos2D.Y - 10)
                    arrowFrame.BackgroundTransparency = 1
                    local img = arrowFrame:FindFirstChild("ArrowImg")
                    if not img then
                        img = Instance.new("ImageLabel", arrowFrame)
                        img.Name = "ArrowImg"
                        img.Size = UDim2.new(1,0,1,0)
                        img.BackgroundTransparency = 1
                        img.Image = "rbxassetid://8532000591"
                        img.ZIndex = 13
                    end
                    img.ImageColor3 = S.BoxColor
                    img.Rotation = math.deg(angle)
                    arrowFrame.Visible = true
                    box3D.Transparency = 1
                else
                    boxFrame.Visible = false
                end
            elseif boxStyle == "Circle" then
                if rootPos2D then
                    local radius = 30 + (dist / 20)
                    boxFrame.Size = UDim2.new(0, radius*2, 0, radius*2)
                    boxFrame.Position = UDim2.new(0, rootPos2D.X - radius, 0, rootPos2D.Y - radius)
                    boxFrame.BackgroundTransparency = 1
                    local stroke = boxFrame:FindFirstChildOfClass("UIStroke")
                    if not stroke then
                        stroke = Instance.new("UIStroke", boxFrame)
                    end
                    stroke.Thickness = S.BoxThickness or 2
                    stroke.Color = S.BoxColor
                    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    local corner = boxFrame:FindFirstChildOfClass("UICorner")
                    if not corner then
                        corner = Instance.new("UICorner", boxFrame)
                    end
                    corner.CornerRadius = UDim.new(1,0)
                    boxFrame.Visible = true
                    box3D.Transparency = 1
                else
                    boxFrame.Visible = false
                end
            end
        else
            boxFrame.Visible = false
            box3D.Transparency = 1
        end

        -- ====== OFF‑SCREEN INDICATORS (FIX: use FindFirstChild) ======
        if S.OffscreenIndicators and not isVisible and charRoot then
            local viewportSize = viewport.AbsoluteSize
            local center = Vector2.new(viewportSize.X/2, viewportSize.Y/2)
            local pos2D = vpCam:WorldToViewportPoint(charRoot.Position)
            if pos2D and pos2D.Z > 0 then
                local dir = Vector2.new(pos2D.X, pos2D.Y) - center
                local angle = math.atan2(dir.Y, dir.X)
                local edgeX, edgeY
                if math.abs(dir.X) > math.abs(dir.Y) then
                    local sign = (dir.X > 0) and 1 or -1
                    edgeX = center.X + sign * (viewportSize.X/2 - 10)
                    edgeY = center.Y + (dir.Y / math.abs(dir.X)) * (viewportSize.X/2 - 10)
                else
                    local sign = (dir.Y > 0) and 1 or -1
                    edgeY = center.Y + sign * (viewportSize.Y/2 - 10)
                    edgeX = center.X + (dir.X / math.abs(dir.Y)) * (viewportSize.Y/2 - 10)
                end
                local bestArrow = nil
                local bestDist = math.huge
                for i, arr in ipairs(offscreenIndicators) do
                    local pos = arr.AbsolutePosition + Vector2.new(8,8)
                    local d = (pos - Vector2.new(edgeX, edgeY)).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestArrow = arr
                    end
                end
                if bestArrow then
                    local imgLabel = bestArrow:FindFirstChild("ArrowImg")
                    if imgLabel then
                        bestArrow.Visible = true
                        bestArrow.Position = UDim2.new(0, edgeX - 8, 0, edgeY - 8)
                        imgLabel.ImageColor3 = S.OffscreenColor or Color3.fromRGB(255,255,100)
                        imgLabel.Rotation = math.deg(angle)
                    end
                    for _, a in ipairs(offscreenIndicators) do
                        if a ~= bestArrow then a.Visible = false end
                    end
                end
            end
        else
            for _, a in ipairs(offscreenIndicators) do a.Visible = false end
        end

        -- ====== OVERLAY 2D (nombre, distancia, arma, health) ======
        noTargetLabel.Visible = false

        if S.NameEnabled then
            nameLabel.Text = currentTarget.Name
            nameLabel.TextColor3 = S.NameColor
            nameLabel.Visible = true
            nameShadow.Text = currentTarget.Name
            nameShadow.TextColor3 = Color3.fromRGB(0,0,0)
            nameShadow.Visible = true
        else
            nameLabel.Visible = false
            nameShadow.Visible = false
        end

        if S.DistanceEnabled then
            distLabel.Text = dist .. " m"
            distLabel.Visible = true
            distShadow.Text = dist .. " m"
            distShadow.Visible = true
        else
            distLabel.Visible = false
            distShadow.Visible = false
        end

        if S.WeaponEnabled then
            local tool = char:FindFirstChildOfClass("Tool")
            local weaponName = tool and tool.Name or ""
            local ammo = nil
            if tool then
                local ammoVal = tool:FindFirstChild("Ammo") or tool:FindFirstChild("CurrentAmmo") or tool:FindFirstChild("AmmoCount")
                if ammoVal and ammoVal:IsA("NumberValue") then
                    ammo = math.floor(ammoVal.Value)
                end
            end
            local text = weaponName
            if ammo then text = text .. " [" .. ammo .. "]" end
            weaponLabel.Text = text
            weaponLabel.Visible = true
            weapShadow.Text = text
            weapShadow.Visible = true
        else
            weaponLabel.Visible = false
            weapShadow.Visible = false
        end

        if S.HealthBarEnabled then
            hbBg.Visible = true
            hbFill.Size = UDim2.new(1, -2, healthPct, 0)
            hbFill.Position = UDim2.new(0, 1, 1 - healthPct, 0)
            hbFill.BackgroundColor3 = GetHPColor(healthPct)
        else
            hbBg.Visible = false
        end

        -- Skeleton
        if S.SkeletonEnabled then
            local parts = GetParts(clonedChar)
            local bones = {}
            if parts.UpperTorso then
                bones = {
                    {parts.Head, parts.UpperTorso},
                    {parts.UpperTorso, parts.LowerTorso},
                    {parts.UpperTorso, parts.RightUpperArm},
                    {parts.RightUpperArm, parts.RightLowerArm},
                    {parts.RightLowerArm, parts.RightHand},
                    {parts.UpperTorso, parts.LeftUpperArm},
                    {parts.LeftUpperArm, parts.LeftLowerArm},
                    {parts.LeftLowerArm, parts.LeftHand},
                    {parts.LowerTorso, parts.RightUpperLeg},
                    {parts.RightUpperLeg, parts.RightLowerLeg},
                    {parts.RightLowerLeg, parts.RightFoot},
                    {parts.LowerTorso, parts.LeftUpperLeg},
                    {parts.LeftUpperLeg, parts.LeftLowerLeg},
                    {parts.LeftLowerLeg, parts.LeftFoot},
                }
            elseif parts.Torso then
                bones = {
                    {parts.Head, parts.Torso},
                    {parts.Torso, parts.RightArm},
                    {parts.Torso, parts.LeftArm},
                    {parts.Torso, parts.RightLeg},
                    {parts.Torso, parts.LeftLeg},
                }
            end
            local skelColor = S.SkeletonColor
            local thick = S.SkeletonThickness or 2
            for i, bone in ipairs(bones) do
                if i > MAX_BONES then break end
                local s1 = bone[1] and PartTo2D(bone[1])
                local s2 = bone[2] and PartTo2D(bone[2])
                if s1 and s2 then
                    DrawLine(skelLines[i], s1, s2, skelColor, thick)
                else
                    skelLines[i].Visible = false
                end
            end
            for i = #bones + 1, MAX_BONES do
                skelLines[i].Visible = false
            end
        else
            for _, l in ipairs(skelLines) do l.Visible = false end
        end
    end)

    -- =========================================================================
    -- LIVE BLINK
    -- =========================================================================
    task.spawn(function()
        while true do
            task.wait(0.8)
            if panel.Visible then
                TweenService:Create(liveLabel, TweenInfo.new(0.2), {BackgroundTransparency = 0.6}):Play()
                task.wait(0.25)
                TweenService:Create(liveLabel, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
            end
        end
    end)

    -- =========================================================================
    -- API PÚBLICA
    -- =========================================================================
    _G.ESPPreview = _G.ESPPreview or {}
    function _G.ESPPreview:Enable()
        _G.ESPPreview.Enabled = true
        panel.Visible = true
    end
    function _G.ESPPreview:Disable()
        _G.ESPPreview.Enabled = false
        panel.Visible = false
        DestroyClone()
        currentTarget = nil
    end
    function _G.ESPPreview:SetTheme(themeName)
        if THEMES[themeName] then
            S.Theme = themeName
            applyTheme(themeName)
        end
    end

    print("=== ESP PREVIEW PANEL FINAL CORREGIDO CARGADO ===")
end
